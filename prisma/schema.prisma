generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  name               String?   // Optional
  email              String    @unique 
  role               AdminRole @default(DOMAIN_HEAD)
  domainId           String?   @db.ObjectId
  domain             Domain?   @relation(fields: [domainId], references: [id])
  slotsCreated       Slot[]    @relation("AdminSlots")
}

model Domain {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  name   String  @unique // e.g., "TECHNICAL", "MANAGEMENT"
  admins Admin[]
}

model User {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  registrationNumber String   @unique 
  email              String   @unique
  phone              String
  stage              Stage    @default(FORM_FILLING) 
  responses          String[] 
  review1Marks       Int?     
  review1Comments    String?  
  review1Passed      Boolean  @default(false) 
  review2Marks       Int?     
  review2Comments    String?  
  review2Passed      Boolean  @default(false) 
  bookedSlot         Slot?   
}

model Slot {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  startTime     DateTime 
  endTime       DateTime 
  meetingLink   String   // The Google Meet link the Head pastes
  isBooked      Boolean  @default(false)
  
  // Connects the slot to the specific Head conducting the interview
  interviewerId String   @db.ObjectId
  interviewer   Admin    @relation("AdminSlots", fields: [interviewerId], references: [id])
  
  // Connects the slot to the shortlisted Candidate who chose it
  userId        String?  @unique @db.ObjectId 
  user          User?    @relation(fields: [userId], references: [id])
}

enum AdminRole {
  ROOT_ADMIN
  DOMAIN_HEAD
}

enum Stage {
  FORM_FILLING
  SHORTLISTED     
  SLOT_CHOOSING   
  INTERVIEW       
  SELECTED
  REJECTED
}